  "captions": [
    {
      "from": 0.61,
      "duration": 0.91,
      "text": "我是阿遥。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 2.363,
      "duration": 2.773,
      "text": "这次回武汉，本来只打算住一晚。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 7.31,
      "duration": 1.631,
      "text": "外公在姨妈家休养，",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 9.238,
      "duration": 1.673,
      "text": "还惦记着铺子里的东西，",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 11.346,
      "duration": 1.721,
      "text": "让我替他给街坊送回去。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 16.61,
      "duration": 1.199,
      "text": "先去找林婆婆。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 18.557,
      "duration": 2.726,
      "text": "借辆车，还是走小时候那条路。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 31.31,
      "duration": 1.481,
      "text": "她一眼就认出了我，",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 33.277,
      "duration": 1.796,
      "text": "还翻出我小时候画的画。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 35.74,
      "duration": 1.773,
      "text": "原来，她一直留着。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 39.31,
      "duration": 1.234,
      "text": "蔡姨忙不过来，",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 40.939,
      "duration": 2.636,
      "text": "我就去杂货铺，帮她把东西带齐。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 47.31,
      "duration": 2.619,
      "text": "开车到了江边，我又停了下来。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 50.776,
      "duration": 2.515,
      "text": "那张老照片，还是头一回见。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 54.91,
      "duration": 1.383,
      "text": "我还借了条小船。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 56.732,
      "duration": 2.57,
      "text": "桨一划开，连赶路的事都忘了。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 63.81,
      "duration": 1.285,
      "text": "本来就想划一划，",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 65.462,
      "duration": 2.255,
      "text": "结果，还认真比起赛来了。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 71.31,
      "duration": 2.112,
      "text": "快下雨了，我得回去看看。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 73.935,
      "duration": 1.18,
      "text": "婆婆有人接没有？",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 75.578,
      "duration": 1.351,
      "text": "蔡姨的饭送到了没？",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 80,
      "duration": 5.55,
      "text": "到了，跟陈姐坐里面。饭也到了，周伯刚报了平安。",
      "who": "小许",
      "presentation": "subtitle"
    },
    {
      "from": 86.61,
      "duration": 2.775,
      "text": "听见她说平安，我才松了口气。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 90.042,
      "duration": 2.07,
      "text": "要不，就再住两天吧。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 96.11,
      "duration": 1.32,
      "text": "这一趟带回来的，",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 97.567,
      "duration": 1.648,
      "text": "好像比送出去的还多。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 109.61,
      "duration": 2.059,
      "text": "小时候，是他们照应我。",
      "who": "阿遥",
      "presentation": "subtitle"
    },
    {
      "from": 112.165,
      "duration": 2.251,
      "text": "这回，换我给他们留盏灯。",
      "who": "阿遥",
      "presentation": "subtitle"
    }
  ],
